+def _cartoon_c_board_layer(state, t):
+    """透明文字与真实可动画单词卡，叠在画好的绿色木框黑板上。"""
+    L = Image.new("RGBA", (W, BOARD_H), (0, 0, 0, 0))
+    d = ImageDraw.Draw(L)
+    # 「今日单词」固定标题已经印在9:16背景图中；这里只叠加本集动态单词卡，避免文字重复。
+    all_words = state.get("words") or []
+    visible = [w for w in all_words if word_phase(w, t)[0] in ("fly", "landed")]
+    if not visible:
+        return L
+    slots, fvi, fzh = layout_chips(visible, plan=all_words, cartoon=True)
+    for w, x, y, cw, ch in slots:
+        phase, local = word_phase(w, t)
+        alpha = 1.0 if phase == "landed" else max(0.0, (ease_inout(local / float(w.get("fly", CARD_FLY))) - 0.93) / 0.07)
+        _draw_chip(L, x, y, cw, ch, w, fvi, fzh, alpha)
+    return L
